# Токен от @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ID админов через запятую (для статистики и модерации)
ADMIN_IDS=123456789

# Цены в Telegram Stars
PRICE_BEST_TEAM=5
PRICE_HIGHLIGHT=7
PRICE_CONTACT_PACK=3
PRICE_PRO_SUBSCRIPTION=15
PRICE_SINGLE_CONTACT=2
PRICE_PREMIUM_APPLICATION=3

# Super+ подписка ($15/мес, рекуррентные Stars, автопродление).
# Недельные гранты активным подписчикам (монеты/звёзды/ключи Autumn).
SUPER_PRICE_STARS=999
SUPER_DURATION_DAYS=30
SUPER_WEEKLY_COINS=75000
SUPER_WEEKLY_STARS=100
SUPER_WEEKLY_KEYS=10

# База данных PostgreSQL (обязательно для продакшена)
# Формат: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://user:password@host:5432/database

# Публичный HTTPS-адрес Mini App.
# На Render можно не задавать — подставится RENDER_EXTERNAL_URL автоматически.
# Локально: ngrok/localtunnel → https-адрес сюда.
WEBAPP_URL=https://your-app.onrender.com

# На чём поднимается локальный веб-сервер (обычно менять не нужно)
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Discord OAuth (для привязки Discord к профилю)
# Создай приложение на https://discord.com/developers/applications
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=your-client-secret
# Redirect URI — должен совпадать с указанным в Discord Developer Portal
DISCORD_REDIRECT_URI=https://your-app.onrender.com/api/discord/callback
# Bot token (опционально — для получения данных о серверах)
DISCORD_BOT_TOKEN=
# Discord server/channel/role IDs for bot features (auto-role, verified role, push notifications)
# Получить: правый клик → Copy ID (включи Dev Mode в Discord Settings → Advanced)
DISCORD_GUILD_ID=0
DISCORD_CHANNEL_ID=0
DISCORD_VERIFIED_ROLE_ID=0

# Steam OpenID + Web API (для привязки Steam)
# Получи: https://steamcommunity.com/dev/apikey (домен = твой WEBAPP_URL без https://)
STEAM_WEB_API_KEY=
STEAM_REDIRECT_URI=https://your-app.onrender.com/api/steam/callback

# Ключ шифрования Discord токенов (Fernet). 
# Сгенерируй: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Если не задан — используется SHA256(BOT_TOKEN) (менее безопасно)
FERNET_KEY=

# AI-модератор «Страж» (всё free: Gemini Flash / Groq + локальные эвристики).
# Ключ — только сюда и в Render env, НИКОГДА в код/чат.
# AI_MOD_ENABLED=1 + AI_MOD_SHADOW=1: shadow mode (вердикты в лог/аудит, ноль действий).
# AI_MOD_SHADOW=0: полный автопилот по лестнице.
AI_MOD_ENABLED=0
AI_MOD_SHADOW=1
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Модель Gemini (сент. 2026: Google требует 3.x, напр. gemini-3.6-flash).
# Пусто = дефолт из кода. Перекрыть без правок кода при ретайре модели.
GEMINI_MODEL=
# Модели Groq через запятую по приоритету (дефолт: openai/gpt-oss-20b;
# живые id: console.groq.com/docs/models). На 404 идём к следующей сами.
GROQ_MODEL=
AI_MOD_SCORE_LOW=0.3
AI_MOD_SCORE_HIGH=0.8
AI_MOD_NIGHT_CAP=30
# Страж-собеседник: отвечает на упоминания «страж» в общем чате.
AI_CHAT_ENABLED=0
AI_CHAT_COOLDOWN_S=60
AI_CHAT_MAX_PER_HOUR=15
# Свой характер Стража без правок кода (дописывается к системному промпту).
# Пример: AI_CHAT_PERSONA=Обращайся ко всем «боец», про CS2 отвечай с душой.
AI_CHAT_PERSONA=
