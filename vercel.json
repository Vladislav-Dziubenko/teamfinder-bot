{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "web-src/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/webhook/(.*)",
      "dest": "api/webhook.py"
    },
    {
      "src": "/(.*)",
      "dest": "web-src/$1"
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false,
  "env": {
    "PYTHON_VERSION": "3.11"
  }
}
