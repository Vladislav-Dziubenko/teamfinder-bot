{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "web-src/package.json",
      "use": "@vercel/next"
    }
  ],
  "rewrites": [
    {
      "source": "/webhook/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/web-src/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/online",
      "schedule": "*/5 * * * *"
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false,
  "env": {
    "PYTHON_VERSION": "3.11"
  }
}
